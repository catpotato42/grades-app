# Canvas OAuth2 configuration for the WebView login flow.
# Copy to .env and fill in. All three are required or the Canvas login
# screen reports itself as unconfigured and refuses to open the WebView.

# Client ID from the Canvas developer key issued by the institution.
# This project never obtained one, which is why the OAuth flow is unfinished.
EXPO_PUBLIC_CANVAS_CLIENT_ID=

# Redirect URI registered on that same developer key. The WebView watches
# for navigation to this URL and pulls ?code= off it.
EXPO_PUBLIC_CANVAS_REDIRECT_URI=

# Backend that exchanges the authorization code for an access token, so the
# client secret stays off the device. Expects POST {code, domain} and returns
# {access_token}.
EXPO_PUBLIC_PROXY_URL=
